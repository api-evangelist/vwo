{
  "opencollection": "1.0.0",
  "info": {
    "name": "VWO Data Campaigns Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all metric reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.vwo.com/api/v2/accounts/:account_id/insights/reports",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Use the literal `current` keyword to refer to the Main Workspace, or the integer Workspace ID."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves insights metrics for a specific account, with pagination and filtering."
        }
      ]
    }
  ],
  "bundled": true
}